# Server-only secrets. Never prefix these with VITE_.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Required for every /api/admin/* endpoint. Never expose it to the user frontend.
ADMIN_API_TOKEN=

# EKP read-only API v1. DATA_API_TOKEN is sent only as the server-side X-API-Key header.
DATA_API_BASE_URL=http://183.63.194.18:8098
DATA_API_PREFIX=/open-api/v1
DATA_API_TOKEN=
DATA_API_TIMEOUT_MS=15000
DATA_API_PAGE_SIZE=500
DATA_API_MAX_PAGES=40
# Number of assigned customers queried in parallel. Keep low to avoid EKP 429 rate limits.
DATA_API_DELIVERY_CONCURRENCY=3

# Real EKP employee scope used by this POC. Use an employeeCode that exists in the API.
DATA_API_EMPLOYEE_CODE=

# BI aggregation settings. Confirm the amount field in http://183.63.194.18:8098/v3/api-docs.
DATA_API_PERIOD=
DATA_API_SALES_AMOUNT_FIELD=
DATA_API_AMOUNT_DIVISOR=10000
DATA_API_SEASONAL_PRODUCT_LINE=月饼
DATA_API_SEASONAL_CATEGORY=
DATA_API_SEASONAL_DEADLINE=
DATA_API_NEW_PRODUCT_MATCH=

# auto: try live API, fall back to labelled demo data; live: fail if API fails; demo: never call API.
DATA_API_MODE=auto
PORT=8787

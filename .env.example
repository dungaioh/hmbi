# Server-only secrets. Never prefix these with VITE_.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Required for every /api/admin/* endpoint. Never expose it to the user frontend.
ADMIN_API_TOKEN=

# Read-only data API. The adapter posts a view query to DATA_API_QUERY_PATH.
DATA_API_BASE_URL=http://183.63.194.18:8098
DATA_API_QUERY_PATH=/open-api/query
DATA_API_TOKEN=
DATA_API_TIMEOUT_MS=4500

# auto: try live API, fall back to labelled demo data; live: fail if API fails; demo: never call API.
DATA_API_MODE=auto
PORT=8787
